; SPDX-License-Identifier: GPL-2.0-or-later
; Development bootstrap only: GIP data plane and signed catalog are not available.
; This is not part of the alpha.2 installer. Do not bind it to a daily-use adapter.
[Version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
CatalogFile=xone-native.cat
DriverVer=10/13/2026,0.2.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0
[Models.NTamd64.10.0]
%Adapter%=Native,USB\VID_045E&PID_02FE

[Native.NT]
Include=xboxgip.inf
Needs=Install
Characteristics=0x4
BusType=15
*IfType=281
*MediaType=0
*PhysicalMediaType=19
CopyFiles=Native.Copy
AddReg=Native.Ndi

[Native.NT.Services]
Include=xboxgip.inf
Needs=Install.Services
AddService=xone-native,2,Native.Service

[Native.NT.HW]
AddReg=Native.Filter
[Native.Filter]
HKR,,UpperFilters,0x00010008,"xboxgip"
[Native.Ndi]
HKR,Ndi,Service,0,"xone-native"
HKR,Ndi\Interfaces,UpperRange,0,"ndisgip"
HKR,Ndi\Interfaces,LowerRange,0,"xboxwirelessinput"

[Native.Service]
DisplayName=%Service%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\xone-native.sys
LoadOrderGroup=NDIS

[Native.Copy]
xone-native.sys
[DestinationDirs]
Native.Copy=13
[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
xone-native.sys=1
[Strings]
Provider="xone Windows project"
Adapter="Xbox Wireless Adapter (xone native bootstrap)"
Service="xone native Xbox wireless transport"
Disk="xone native driver development package"
